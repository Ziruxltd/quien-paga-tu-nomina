---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import Cabecera from '../../components/Cabecera.astro';
import Comparativa from '../../components/Comparativa.astro';
import { LOCALES, type Locale } from '../../i18n/ui';
import { t } from '../../i18n/utils';

export const getStaticPaths = (() => LOCALES.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const lang = Astro.params.lang as Locale;
const tx = t(lang);
---

<Base lang={lang} ruta="compare" title={`${tx.titulo} · ${tx.comparar}`} description={tx.cmpLede}>
  <main id="main" class="wrap">
    <Cabecera lang={lang} eyebrow={tx.cmpEyebrow} titulo={tx.cmpTitulo} lede={tx.cmpLede} />
    <Comparativa lang={lang} />
  </main>
</Base>
