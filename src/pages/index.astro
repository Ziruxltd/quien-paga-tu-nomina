---
// Redirige a la página del primer país en el idioma del navegador.
import { PAISES } from '../data/paises';
import { DEFAULT_LOCALE, LOCALES, UI } from '../i18n/ui';
import { pathFor } from '../i18n/utils';

const slug = PAISES[0].slug;
const destino = pathFor(DEFAULT_LOCALE, slug);
---

<!doctype html>
<html lang={DEFAULT_LOCALE}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{UI[DEFAULT_LOCALE].titulo}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline define:vars={{ locales: LOCALES, slug, def: DEFAULT_LOCALE }}>
      const pref = (navigator.languages || [navigator.language]).map((l) => String(l).slice(0, 2).toLowerCase());
      const lang = pref.find((l) => locales.includes(l)) || def;
      location.replace('/' + lang + '/' + slug + '/');
    </script>
    <noscript><meta http-equiv="refresh" content={`0; url=${destino}`} /></noscript>
  </head>
  <body>
    <ul>
      {LOCALES.map((l) => <li><a href={pathFor(l, slug)} hreflang={l}>{UI[l].titulo}</a></li>)}
    </ul>
  </body>
</html>
