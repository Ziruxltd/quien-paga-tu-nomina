---
import '../styles/global.css';
import Navegacion from '../components/Navegacion.astro';
import { LOCALES, type Locale } from '../i18n/ui';
import { pathFor } from '../i18n/utils';

interface Props {
  lang: Locale;
  /** Slug del país o 'compare' */
  ruta: string;
  title: string;
  description?: string;
}

const { lang, ruta, title, description } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    {description && <meta name="description" content={description} />}
    {LOCALES.map((l) => <link rel="alternate" hreflang={l} href={pathFor(l, ruta)} />)}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo+Narrow:wght@500;600;700&family=Source+Sans+3:wght@400;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
    />
  </head>
  <body>
    <Navegacion lang={lang} ruta={ruta} />
    <slot />
  </body>
</html>
