---
import type { Locale } from '../i18n/ui';
import { t } from '../i18n/utils';

interface Props {
  lang: Locale;
}

const tx = t(Astro.props.lang);
---

<section aria-labelledby="h-res">
  <h2 id="h-res" class="eyebrow" style="font-family:var(--f-data);font-size:.75rem;font-weight:500">{tx.resultadoTitulo}</h2>
  <div class="result">
    <div class="split">
      <div class="side pub"><span class="pct num" id="pctPub">–</span><span class="lbl">{tx.ingresoPub}</span><span class="abs num" id="absPub"></span></div>
      <div class="side priv"><span class="pct num" id="pctPriv">–</span><span class="lbl">{tx.ingresoPriv}</span><span class="abs num" id="absPriv"></span></div>
    </div>
    <div>
      <div class="bar100" role="img" id="bar100">
        <div class="b-pub" id="bPub" style="flex-basis:50%"></div>
        <div class="b-priv" id="bPriv" style="flex-basis:50%"></div>
      </div>
      <div class="midline"><span>50%</span></div>
    </div>
    <p class="ratio" id="ratio"></p>
  </div>
</section>
