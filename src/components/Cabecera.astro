---
import type { Locale } from '../i18n/ui';
import { t } from '../i18n/utils';

interface Props {
  lang: Locale;
  eyebrow: string;
  titulo: string;
  lede: string;
}

const { lang, eyebrow, titulo, lede } = Astro.props;
---

<header>
  <span class="eyebrow">{eyebrow}</span>
  <h1>{titulo}</h1>
  <p class="lede">{lede}</p>
  <span class="badge">{t(lang).badge}</span>
</header>
