---
import type { Pais } from '../data/paises/types';
import type { Locale } from '../i18n/ui';
import { t } from '../i18n/utils';

interface Props {
  lang: Locale;
  advertencias: Pais['advertencias'];
}

const { lang, advertencias } = Astro.props;
---

<section aria-labelledby="h-cav">
  <h2 id="h-cav">{t(lang).cavTitulo}</h2>
  <div class="caveats">
    {advertencias.map((a) => (
      <div class="cav"><span class="dir">{a.dir[lang]}</span><h3>{a.titulo[lang]}</h3><p>{a.texto[lang]}</p></div>
    ))}
  </div>
</section>
