---
import type { Pais } from '../data/paises/types';
import { PRESET_IDS } from '../data/paises/types';
import type { Locale } from '../i18n/ui';
import { fmt, t } from '../i18n/utils';

interface Props {
  lang: Locale;
  pais: Pais;
}

const { lang, pais } = Astro.props;
const tx = t(lang);
const grupo = (id: string) => pais.grupos.find((g) => g.id === id)!;
---

<section aria-labelledby="h-sup">
  <h2 id="h-sup">{tx.supTitulo}</h2>
  <p>{tx.supTexto}</p>
  <div class="presets" role="group" aria-label={tx.escenarios}>
    {PRESET_IDS.map((id) => <button type="button" data-preset={id}>{tx.presets[id]}</button>)}
  </div>
  <div class="panel">
    {pais.toggles.map((tg) => {
      const g = grupo(tg.grupo);
      return g.alt ? (
        <div class="toggle" style="cursor:default">
          <input type="checkbox" id={'t-' + g.id} data-grupo={g.id} checked aria-label={tg.titulo[lang]} />
          <span class="t"><b>{tg.titulo[lang]}</b><small>{tg.detalle[lang]}</small>
            <span class="seg" role="group" aria-label={tg.titulo[lang]}>
              <button type="button" data-alt={g.id} data-valor="0" aria-pressed="true">{g.alt.baseLabel[lang]} · {fmt(lang, g.v, 2)} M</button>
              <button type="button" data-alt={g.id} data-valor="1" aria-pressed="false">{g.alt.label[lang]} · {fmt(lang, g.alt.v, 2)} M</button>
            </span>
          </span>
        </div>
      ) : (
        <label class:list={['toggle', { privtg: g.side === 'priv' }]}>
          <input type="checkbox" id={'t-' + g.id} data-grupo={g.id} checked />
          <span class="t"><b>{tg.titulo[lang]}</b><small>{tg.detalle[lang]}</small></span>
        </label>
      );
    })}
    <div class="slider">
      <label for="sOver"><span>{tx.overTitulo}</span><span class="num" id="vOver"></span></label>
      <input type="range" id="sOver" min="0" max={pais.overMax} step="0.1" value="0" />
      <small>{tx.overTexto}</small>
    </div>
  </div>
</section>
