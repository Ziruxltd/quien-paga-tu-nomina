---
import type { Locale } from '../i18n/ui';
import { t } from '../i18n/utils';

interface Props {
  lang: Locale;
  metodo: string;
}

const { lang, metodo } = Astro.props;
const tx = t(lang);
---

<section aria-labelledby="h-calc">
  <h2 id="h-calc">{tx.calcTitulo}</h2>
  <p>{tx.calcTexto} {metodo}</p>
  <div class="calc">
    <table class="t-calc">
      <thead><tr><th>{tx.thGrupo}</th><th>{tx.thFuente}</th><th style="text-align:right">{tx.thPersonas}</th></tr></thead>
      <tbody id="tbody"></tbody>
    </table>
  </div>
  <div class="formula" id="formula"></div>
</section>
