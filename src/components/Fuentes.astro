---
import type { Pais } from '../data/paises/types';
import type { Locale } from '../i18n/ui';
import { t } from '../i18n/utils';

interface Props {
  lang: Locale;
  fuentes: Pais['fuentes'];
}

const { lang, fuentes } = Astro.props;
---

<section aria-labelledby="h-src">
  <h2 id="h-src">{t(lang).fuentesTitulo}</h2>
  <ul class="sources">
    {fuentes.map((f) => <li><a href={f.url} target="_blank" rel="noopener">{f.texto}</a></li>)}
  </ul>
</section>
