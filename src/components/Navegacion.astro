---
import { PAISES } from '../data/paises';
import { LOCALES, UI, type Locale } from '../i18n/ui';
import { pathFor, t } from '../i18n/utils';

interface Props {
  lang: Locale;
  ruta: string;
}

const { lang, ruta } = Astro.props;
const tx = t(lang);
const tabs = [...PAISES.map((p) => ({ ruta: p.slug, label: p.nombre[lang] })), { ruta: 'compare', label: tx.comparar }];

// Banderas en SVG: los emojis de bandera no se ven en Windows.
const BANDERAS: Record<Locale, string> = {
  es: '<rect width="30" height="20" fill="#AA151B"/><rect y="5" width="30" height="10" fill="#F1BF00"/>',
  en: '<clipPath id="fl-gb"><rect width="30" height="20"/></clipPath><g clip-path="url(#fl-gb)"><rect width="30" height="20" fill="#012169"/><path d="M0 0L30 20M30 0L0 20" stroke="#fff" stroke-width="4"/><path d="M0 0L30 20M30 0L0 20" stroke="#C8102E" stroke-width="1.6"/><path d="M15 0V20M0 10H30" stroke="#fff" stroke-width="6"/><path d="M15 0V20M0 10H30" stroke="#C8102E" stroke-width="3.4"/></g>',
  pt: '<rect width="30" height="20" fill="#DA291C"/><rect width="12" height="20" fill="#046A38"/><circle cx="12" cy="10" r="4.2" fill="none" stroke="#FFE900" stroke-width="1.4"/><path d="M10.2 7.8h3.6v3.4a1.8 1.8 0 0 1-3.6 0z" fill="#fff" stroke="#DA291C" stroke-width=".7"/>',
};
---

<a class="skip" href="#main">{tx.saltar}</a>
<nav class="topbar" aria-label={tx.navPaises}>
  <div class="topbar-in">
    <ul class="tabs" id="tabs">
      {tabs.map((tab) => (
        <li>
          <a href={pathFor(lang, tab.ruta)} aria-current={tab.ruta === ruta ? 'page' : undefined}>{tab.label}</a>
        </li>
      ))}
    </ul>
    <ul class="langs" aria-label={tx.navIdioma}>
      {LOCALES.map((l) => (
        <li>
          <a
            href={pathFor(l, ruta)}
            hreflang={l}
            lang={l}
            aria-label={UI[l].nombreIdioma}
            title={UI[l].nombreIdioma}
            aria-current={l === lang ? 'true' : undefined}
          >
            <svg viewBox="0 0 30 20" width="28" height="19" aria-hidden="true" set:html={BANDERAS[l]} />
          </a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<script is:inline>
  // En pantallas estrechas las pestañas se desplazan en horizontal: centra la activa y marca si quedan más a cada lado.
  (() => {
    const ul = document.getElementById('tabs');
    if (!ul) return;
    const actual = ul.querySelector('[aria-current="page"]');
    const marca = () => {
      ul.classList.toggle('mas', ul.scrollLeft + ul.clientWidth < ul.scrollWidth - 2);
      ul.classList.toggle('menos', ul.scrollLeft > 2);
    };
    const centra = () => {
      if (actual) {
        const a = actual.getBoundingClientRect(), u = ul.getBoundingClientRect();
        ul.scrollLeft += a.left - u.left - (u.width - a.width) / 2;
      }
      marca();
    };
    centra();
    // Las fuentes web cambian el ancho de las pestañas al cargar
    document.fonts?.ready.then(centra);
    ul.addEventListener('scroll', marca, { passive: true });
    addEventListener('resize', marca);
  })();
</script>
